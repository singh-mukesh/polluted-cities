{
  "name": "polluted-cities-service",
  "version": "1.0.0",
  "description": "Serverless service to fetch polluted cities and enrich with Wikipedia descriptions",
  "type": "module",
  "main": "src/handlers/getCities.js",
  "scripts": {
    "start": "sls offline",
    "dev": "sls offline",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "test": "mocha \"tests/**/*.test.js\" --timeout 30000"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "joi": "^17.10.0",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^5.2.1",
    "jest": "^29.7.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "serverless": "^3.37.1",
    "serverless-offline": "^13.3.2"
  }
}
